    <string name="permissions_header">Permissions</string>
    <string name="permission_required">required</string>
    <string name="permission_recommended">recommended</string>
    <string name="permission_grant">Open settings</string>
    <string name="permission_app_blocking_title">App blocking</string>
    <string name="permission_app_blocking_description">Turn on “Just Focus” in Accessibility settings. If the option is greyed out: App info → ⋮ → “Allow restricted settings”.</string>
    <string name="permission_notification_filtering_title">Notification filtering</string>
    <string name="permission_notification_filtering_description">Holds back notifications from non-emergency apps until the session ends.</string>
    <string name="permission_notifications_title">Just Focus notifications</string>
    <string name="permission_notifications_description">To show the countdown and tell you when the session is over.</string>
    <string name="permission_exact_alarm_title">Alarms &amp; reminders</string>
    <string name="permission_exact_alarm_description">So the end-of-session notification arrives on time, even with the screen off.</string>

